{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-static-pages.mjs && node scripts/build-og-images.mjs && node scripts/build-sitemap.mjs && node scripts/build-rss.mjs && node scripts/inject-verification.mjs && node scripts/inject-fingerprint.mjs",
    "build:dev": "vite build --mode development && node scripts/build-static-pages.mjs && node scripts/build-og-images.mjs && node scripts/build-sitemap.mjs && node scripts/build-rss.mjs && node scripts/inject-verification.mjs && node scripts/inject-fingerprint.mjs",
    "build:app": "vite build",
    "seo:static-pages": "node scripts/build-static-pages.mjs",
    "seo:og": "node scripts/build-og-images.mjs",
    "seo:rss": "node scripts/build-rss.mjs",
    "seo:sitemap": "node scripts/build-sitemap.mjs",
    "seo:verify": "node scripts/inject-verification.mjs",
    "seo:fingerprint": "node scripts/inject-fingerprint.mjs",
    "seo:indexnow": "node scripts/indexnow-submit.mjs",
    "kb:refresh": "node --env-file-if-exists=../.env scripts/fetch-knowledge.mjs && prettier --write src/generated/knowledge.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,mts,js,mjs,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,mts,js,mjs,jsx,json,css}\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "size": "size-limit"
  },
  "//size-limit": "react-vendor was re-baselined 60 -> 78 KB on the React 18 -> 19 migration. Measured: 58.97 KB gzip on React 18.3.1 vs 73.58 KB on React 19.2.8 -- a deliberate +14.6 KB framework cost, NOT drift. The headroom above 73.58 is intentionally small so genuine regressions still trip the gate. If this budget is exceeded again, investigate rather than raise it.",
  "size-limit": [
    {
      "name": "main JS (app code)",
      "path": "dist/assets/index-*.js",
      "limit": "90 KB",
      "gzip": true
    },
    {
      "name": "react-vendor (eager)",
      "path": "dist/assets/react-vendor-*.js",
      "limit": "78 KB",
      "gzip": true
    },
    {
      "name": "radix-vendor (eager)",
      "path": "dist/assets/radix-vendor-*.js",
      "limit": "35 KB",
      "gzip": true
    },
    {
      "name": "motion-vendor (eager)",
      "path": "dist/assets/motion-vendor-*.js",
      "limit": "30 KB",
      "gzip": true
    },
    {
      "name": "CSS",
      "path": "dist/assets/index-*.css",
      "limit": "40 KB",
      "gzip": true
    }
  ],
