# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/
**/dist/
**/build/

# Environment files
.env
.env.local
.env.*.local
**/.env
**/.env.local
# Secret hygiene: ignore any suffixed env file everywhere (e.g. a real .env.production),
# but keep committed *.example templates AND the public Vite build config tracked.
**/.env.*
!**/.env.example
!**/.env.*.example
# Public, non-secret Vite build config (VITE_* baked into the client bundle).
# .env.production is deliberately NOT tracked: `vite build` loads it for EVERY
# production build, so a homelab-shaped file (VITE_USE_API=true, VITE_API_URL=/api)
# silently leaked into the Cloudflare bundle, which has no backend. Per-target
# VITE_* values now come from the deploy workflow's env: block (Cloudflare) and
# the Dockerfile's ARG defaults (homelab).
!portfolio-ui/.env.development

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
.tmp/

# Node package files — HARD RULE: never commit these
package-lock.json
**/package-lock.json
yarn.lock
**/yarn.lock
pnpm-lock.yaml
**/pnpm-lock.yaml
bun.lockb
*.lockb

# Claude worktrees
.claude/worktrees/

# Shared package build output
shared/dist/
.claude/settings.local.json
node_modules/.package-lock.json

# Playwright artifacts
playwright-report/
test-results/
**/playwright-report/
**/test-results/
# Lighthouse CI writes ~7k-line LHR reports per URL per run into the repo root.
.lighthouseci/

# TypeScript build info
*.tsbuildinfo
**/*.tsbuildinfo

# Local artifacts — screenshots, RuVector graph caches, Playwright MCP page snapshots
.playwright-mcp/
hero-*.png
*-final-*.png
ruvector.db
**/ruvector.db
# Agent vector stores: index repository content, must never be committed
*.rvf
*.rvf.lock
agentdb.*

# Local docker-compose port-remap overlay. Encodes THIS machine's port
# conflicts with unrelated projects (personal-finance-analyzer holds
# 5432/6379/3000, trading-bot holds 8080) — a fact about one laptop, not about
# this repo. Committing it would bake another project's port claims into
# shared config.
docker-compose.ports.yml

# Database dumps. backup-db.sh previously could not run at all (its shebang was
# CRLF, so Linux rejected it); fixing that made it live, and its documented
# invocation `./scripts/backup-db.sh -e prod` writes a full unencrypted pg_dump
# containing password hashes, refresh tokens, OAuth tokens and IP addresses.
# gitleaks cannot backstop this -- .dump and .sql.gz are compressed binary and
# bcrypt hashes match no secret rule. Deliberately NOT ignoring bare *.sql:
# prisma/migrations/**/migration.sql is tracked and must stay tracked.
backups/
*.sql.gz
*.dump

# playwright-cli session snapshots
.playwright-cli/

# Dev screenshots dropped at the repo root by ad-hoc browser runs. 8.7MB of them
# were tracked and referenced by nothing -- no README embed, no doc, no code.
# Root-anchored (`/`) on purpose: portfolio-ui/public/ ships real icons and
# og images. A bare `*.png` would silently untrack those.
/*.png

# The cloudflared binary. A 38MB darwin build was committed at the root and used
# by nothing -- docs/ correctly tells you to curl the linux .deb onto the homelab
# node instead (Auto Run Docs/ultraplan-2.md:24).
/cloudflared
