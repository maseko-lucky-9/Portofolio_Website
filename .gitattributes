# Normalize all text files to LF in the repository.
# Git auto-detects text vs binary; declared text files are stored with LF.
* text=auto eol=lf

# Explicit text types (force LF regardless of detection)
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.tf    text eol=lf
*.tfvars text eol=lf
*.hcl   text eol=lf
*.sql   text eol=lf
*.prisma text eol=lf
*.svg   text eol=lf
*.xml   text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf
*.tpl   text eol=lf
*.conf  text eol=lf
*.webmanifest text eol=lf

# Shell scripts must always use LF
*.sh    text eol=lf

# Binary files — never normalize, never diff as text
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary
*.mp4   binary
*.webm  binary
*.zip   binary
*.gz    binary

# Project-specific binary artifacts
cloudflared    binary
*.rvf          binary
*.rvf.lock     binary
